#version 450
// P4 (tools/hot-expert/P4-STILE-SHADER-SPEC-2026-09.md): qmatmul.comp for a
// TILE of R input rows per workgroup instead of one.
//
// The per-row kernel (qmatmul.comp) is dispatched (ceil(O/8), S, 1): every
// input row s re-reads the whole weight matrix, so S rows cost S x |W| of VRAM
// traffic. Here gl_WorkGroupID.y indexes a tile of R rows; each lane loads a
// packed weight word ONCE and applies it to R accumulators.
//
// v2 (P4b): the tile's activations are staged in shared memory, SLICE floats
// per row at a time (R x SLICE x 4 = 32 KB), because v1 read x from global
// memory -- 64 scalar loads per lane per weight word -- and was bound by
// that, not by the weights (VK_PROF 2026-09-06: 0.8 ms of fence wait per
// dense call, the expert group unchanged at 58 ms/token). SLICE/8 (fmt 4)
// and SLICE/4 (fmt 1) words are multiples of any subgroup width, so every
// lane still owns exactly the words it owns in the per-row shader, in the
// same ascending order, with the same per-word arithmetic and the same
// subgroupAdd: y[s, o] stays bit-identical to qmatmul.comp (the gate checks;
// COLI_VK_TILE=0 restores the per-row pipeline).
//
// The o loop is uniform across the workgroup (every subgroup iterates the
// same ob values) so the staging barriers are legal; a subgroup whose o is
// past O just skips the arithmetic. Formats: 1 (int8, per-row scale) and 4
// (grouped int4). The host dispatches this pipeline only for those two and
// only when S > 1.
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer X  { float x[]; };
layout(std430, binding = 1) readonly buffer W  { uint  w[]; };
layout(std430, binding = 2) readonly buffer Sc { float scale[]; };
layout(std430, binding = 3) writeonly buffer Y { float y[]; };

layout(push_constant) uniform P {
    int fmt;
    int S, I, O;
    int rowWords;
    int gs;
} p;

const int R = 8;
const int SLICE = 1024;                 // floats per row per staged slice
shared float xsh[R * SLICE];            // 32 KB

float i8(uint word, int lane) {
    int b = int((word >> (uint(lane) * 8u)) & 0xffu);
    if (b >= 128) b -= 256;
    return float(b);
}
float i4(uint word, int lane) {
    return float(int((word >> (uint(lane) * 4u)) & 0xfu) - 8);
}

void main() {
    int s0     = int(gl_WorkGroupID.y) * R;
    int rows   = min(R, p.S - s0);
    int tid    = int(gl_LocalInvocationID.x);
    int nth    = int(gl_WorkGroupSize.x);
    int sg     = int(gl_SubgroupID);
    int lane   = int(gl_SubgroupInvocationID);
    int sgsize = int(gl_SubgroupSize);
    int nsg    = nth / sgsize;
    int stride = int(gl_NumWorkGroups.x) * nsg;

    for (int ob = int(gl_WorkGroupID.x) * nsg; ob < p.O; ob += stride) {   // uniform
        int o = ob + sg;
        bool live = o < p.O;                                               // subgroup-uniform (live: "active" is reserved in GLSL)
        uint rowBase = uint(o) * uint(p.rowWords);
        float sum[R];
        for (int r = 0; r < R; r++) sum[r] = 0.0;

        for (int sb = 0; sb < p.I; sb += SLICE) {                           // uniform
            int sl = min(SLICE, p.I - sb);
            barrier();                                                       // previous slice fully consumed
            for (int t = tid; t < rows * sl; t += nth) {
                int r = t / sl, j = t - r * sl;
                xsh[r * SLICE + j] = x[(s0 + r) * p.I + sb + j];
            }
            barrier();
            if (live) {
                if (p.fmt == 1) {
                    int wb = sb / 4, we = (sb + sl + 3) / 4;
                    for (int wi = wb + lane; wi < we; wi += sgsize) {
                        uint pk = w[rowBase + uint(wi)]; int i0 = wi * 4, il = i0 - sb;
                        for (int k = 0; k < 4; k++) {
                            int i = i0 + k;
                            if (i < p.I) {
                                float wv = i8(pk, k);
                                for (int r = 0; r < R; r++)
                                    if (r < rows) sum[r] += xsh[r * SLICE + il + k] * wv;
                            }
                        }
                    }
                } else { // fmt 4: grouped int4, per-word group scale (gs % 8 == 0, host-gated)
                    int ng = (p.I + p.gs - 1) / p.gs;
                    uint sbase = uint(o) * uint(ng);
                    int wb = sb / 8, we = (sb + sl + 7) / 8;
                    for (int wi = wb + lane; wi < we; wi += sgsize) {
                        uint pk = w[rowBase + uint(wi)]; int i0 = wi * 8, il = i0 - sb;
                        float a[R];
                        for (int r = 0; r < R; r++) a[r] = 0.0;
                        for (int k = 0; k < 8; k++) {
                            int i = i0 + k;
                            if (i < p.I) {
                                float wv = i4(pk, k);
                                for (int r = 0; r < R; r++)
                                    if (r < rows) a[r] += xsh[r * SLICE + il + k] * wv;
                            }
                        }
                        float sc = scale[sbase + uint(i0 / p.gs)];
                        for (int r = 0; r < R; r++) sum[r] += a[r] * sc;
                    }
                }
            }
        }
        if (live) {
            for (int r = 0; r < R; r++) {
                float tot = subgroupAdd(sum[r]);      // every lane of the subgroup, every r
                if (lane == 0 && r < rows)
                    y[(s0 + r) * p.O + o] = (p.fmt == 4) ? tot : tot * scale[o];
            }
        }
    }
}
