#version 450
// P4 / P4b: qmatmul_gate_up.comp for a TILE of R input rows per workgroup,
// activations staged in shared memory in 32 KB slices. See qmatmul_tile.comp
// for the design and the bit-identity argument; this is the fused
// gate+up+silu variant with two weight streams. Formats 1 and 4 only; the
// host dispatches it only for those and only for an expert with > 1 row.
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer X  { float x[]; };
layout(std430, binding = 1) readonly buffer WG { uint  wg[]; };
layout(std430, binding = 2) readonly buffer SG { float gscale[]; };
layout(std430, binding = 3) readonly buffer WU { uint  wu[]; };
layout(std430, binding = 4) readonly buffer SU { float uscale[]; };
layout(std430, binding = 5) writeonly buffer H { float hid[]; };

layout(push_constant) uniform P {
    int fmt;
    int S, I, O;    // I = input dim (hidden), O = moe_inter
    int rowWords;
    int gs;
} p;

const int R = 8;
const int SLICE = 1024;
shared float xsh[R * SLICE];

float i8(uint w, int l) { int b = int((w >> (uint(l) * 8u)) & 0xffu); if (b >= 128) b -= 256; return float(b); }
float i4(uint w, int l) { return float(int((w >> (uint(l) * 4u)) & 0xfu) - 8); }

void main() {
    int s0     = int(gl_WorkGroupID.y) * R;
    int rows   = min(R, p.S - s0);
    int tid    = int(gl_LocalInvocationID.x);
    int nth    = int(gl_WorkGroupSize.x);
    int lane   = int(gl_SubgroupInvocationID);
    int sgsize = int(gl_SubgroupSize);
    int sg     = int(gl_SubgroupID);
    int nsg    = nth / sgsize;
    int stride = int(gl_NumWorkGroups.x) * nsg;

    for (int ob = int(gl_WorkGroupID.x) * nsg; ob < p.O; ob += stride) {   // uniform
        int o = ob + sg;
        bool live = o < p.O;
        uint rb = uint(o) * uint(p.rowWords);
        float g[R], u[R];
        for (int r = 0; r < R; r++) { g[r] = 0.0; u[r] = 0.0; }

        for (int sb = 0; sb < p.I; sb += SLICE) {
            int sl = min(SLICE, p.I - sb);
            barrier();
            for (int t = tid; t < rows * sl; t += nth) {
                int r = t / sl, j = t - r * sl;
                xsh[r * SLICE + j] = x[(s0 + r) * p.I + sb + j];
            }
            barrier();
            if (live) {
                if (p.fmt == 1) {
                    int wb = sb / 4, we = (sb + sl + 3) / 4;
                    for (int wi = wb + lane; wi < we; wi += sgsize) {
                        uint gp = wg[rb + uint(wi)], upk = wu[rb + uint(wi)]; int i0 = wi * 4, il = i0 - sb;
                        for (int k = 0; k < 4; k++) {
                            int i = i0 + k;
                            if (i < p.I) {
                                float gv = i8(gp, k), uv = i8(upk, k);
                                for (int r = 0; r < R; r++)
                                    if (r < rows) { float xv = xsh[r * SLICE + il + k]; g[r] += xv * gv; u[r] += xv * uv; }
                            }
                        }
                    }
                } else { // fmt 4
                    int ng = (p.I + p.gs - 1) / p.gs;
                    uint sbase = uint(o) * uint(ng);
                    int wb = sb / 8, we = (sb + sl + 7) / 8;
                    for (int wi = wb + lane; wi < we; wi += sgsize) {
                        uint gp = wg[rb + uint(wi)], upk = wu[rb + uint(wi)]; int i0 = wi * 8, il = i0 - sb;
                        float ga[R], ua[R];
                        for (int r = 0; r < R; r++) { ga[r] = 0.0; ua[r] = 0.0; }
                        for (int k = 0; k < 8; k++) {
                            int i = i0 + k;
                            if (i < p.I) {
                                float gv = i4(gp, k), uv = i4(upk, k);
                                for (int r = 0; r < R; r++)
                                    if (r < rows) { float xv = xsh[r * SLICE + il + k]; ga[r] += xv * gv; ua[r] += xv * uv; }
                            }
                        }
                        float sc_g = gscale[sbase + uint(i0 / p.gs)], sc_u = uscale[sbase + uint(i0 / p.gs)];
                        for (int r = 0; r < R; r++) { g[r] += ga[r] * sc_g; u[r] += ua[r] * sc_u; }
                    }
                }
            }
        }
        if (live) {
            for (int r = 0; r < R; r++) {
                float gt = subgroupAdd(g[r]), ut = subgroupAdd(u[r]);
                if (p.fmt != 4) { gt *= gscale[o]; ut *= uscale[o]; }
                if (lane == 0 && r < rows) hid[(s0 + r) * p.O + o] = (gt / (1.0 + exp(-gt))) * ut;
            }
        }
    }
}
